# Copia in .env e adatta. NESSUN segreto reale va committato.
# Database PostgreSQL (dev locale)
DATABASE_URL=postgres://fpm:fpm_dev_only@localhost:5432/fpm_dev
# Database usato SOLO dai test (viene svuotato a ogni esecuzione)
TEST_DATABASE_URL=postgres://fpm:fpm_dev_only@localhost:5432/fpm_test
# Porta API
PORT=8787
# Origine del frontend (CORS e controllo Origin sulle richieste che modificano dati)
WEB_ORIGIN=http://localhost:5173
# Imposta "production" in produzione: cookie Secure e provider di pagamento mock disattivato
NODE_ENV=development
# Provider pagamenti: "mock" (solo sviluppo) | "apple" | "google" | "stripe" (non ancora implementati)
PAYMENT_PROVIDER=mock
# TURN/STUN (Fase D, non ancora usati)
# STUN_URLS=stun:stun.example.org:3478
# TURN_URLS=turn:turn.example.org:3478
# TURN_SHARED_SECRET=
